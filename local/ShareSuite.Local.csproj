<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ShareSuite</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>2.10.1.0</FileVersion>
    <InformationalVersion>2.10.1+local.ror2-1.5.pickup-fix.1</InformationalVersion>
    <GameManaged Condition="'$(GameManaged)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Risk of Rain 2/Risk of Rain 2_Data/Managed</GameManaged>
    <R2Profile Condition="'$(R2Profile)' == ''">$(HOME)/.config/r2modmanPlus-local/RiskOfRain2/profiles/Default</R2Profile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ShareSuite/**/*.cs" Exclude="../ShareSuite/bin/**;../ShareSuite/obj/**" />
    <LocalReference Include="$(GameManaged)/RoR2.dll;$(GameManaged)/HGCSharpUtils.dll;$(GameManaged)/HGUnityUtils.dll;$(GameManaged)/com.unity.multiplayer-hlapi.Runtime.dll;$(GameManaged)/UnityEngine*.dll" />
    <LocalReference Include="$(R2Profile)/BepInEx/core/BepInEx.dll;$(R2Profile)/BepInEx/core/MonoMod.Utils.dll;$(R2Profile)/BepInEx/core/Mono.Cecil.dll" />
    <LocalReference Include="$(R2Profile)/BepInEx/plugins/MMHOOK/MMHOOK_RoR2.dll;$(R2Profile)/BepInEx/plugins/RiskofThunder-R2API_Core/R2API.Core/R2API.Core.dll;$(R2Profile)/BepInEx/plugins/RiskofThunder-R2API_CommandHelper/R2API.CommandHelper/R2API.CommandHelper.dll" />
    <Reference Include="@(LocalReference)">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
